# OpenRouter API Key (for most models)
OPENROUTER_API_KEY=your_key_here

# Google AI API Key (for Gemini 3+ models - required for function calling)
# Get from: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Default model to use
DEFAULT_MODEL=google/gemini-2.5-flash

DATABASE_URL= # leve blank for local sqlite, otherwise takes a postgres connection string

API_KEY= # the key to protect api routes