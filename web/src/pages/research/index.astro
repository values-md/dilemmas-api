---
/**
 * /research — listing of all research experiments.
 *
 * Prerendered at build time. Reads ../research/<slug>/findings.md via the
 * `research` content collection. Sorted by date desc.
 *
 * Mirrors src/dilemmas/api/templates/research_index.html.
 */
export const prerender = true;

import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';

const entries = await getCollection('research');
entries.sort((a, b) => (a.data.date < b.data.date ? 1 : a.data.date > b.data.date ? -1 : 0));
---
<Base title="Research Experiments — VALUES.md">
  <div style="margin-bottom: 30px;">
    <h1>Research Experiments</h1>
    <p class="subtitle">Studies on LLM ethical decision-making</p>
  </div>

  {entries.length === 0 && (
    <div class="empty-state">
      <p>No research experiments found.</p>
    </div>
  )}

  {entries.map((entry) => {
    const fm = entry.data;
    const summary = fm.abstract?.trim() || fm.research_question || '';
    const judgements = fm.data?.judgements ?? 0;
    const dilemmas = fm.data?.dilemmas ?? 0;
    return (
      <div class="card">
        <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 10px;">
          <div>
            <h2 style="margin: 0;">
              <a href={`/research/${entry.id}`} style="color: inherit;">{fm.title}</a>
            </h2>
            <span class="badge badge-domain">{fm.date}</span>
          </div>
        </div>

        {summary && <p style="color: #4a4a4a; margin: 15px 0;">{summary}</p>}

        {fm.key_finding && (
          <div style="background: #f5f5f3; border-left: 3px solid #2c5282; padding: 15px; margin: 15px 0;">
            <strong style="color: #2c5282;">Key Finding:</strong> {fm.key_finding}
          </div>
        )}

        <div class="meta">
          {fm.models.length > 0 && (
            <Fragment>
              <strong>Models:</strong> {fm.models.join(', ')}
              <br />
            </Fragment>
          )}
          {judgements > 0 && (
            <Fragment>
              <strong>Data:</strong> {judgements} judgements
              {dilemmas > 0 && ` across ${dilemmas} dilemmas`}
            </Fragment>
          )}
          {fm.tags.length > 0 && (
            <Fragment>
              <br />
              <strong>Tags:</strong>{' '}
              {fm.tags.map((t) => (
                <span class="badge badge-domain" style="font-size: 0.85em;">{t}</span>
              ))}
            </Fragment>
          )}
        </div>

        <div style="margin-top: 15px;">
          <a
            href={`/research/${entry.id}`}
            class="badge"
            style="background: #2c5282; color: white; text-decoration: none;"
          >
            View Findings →
          </a>
        </div>
      </div>
    );
  })}

  <style>
    @media (max-width: 768px) {
      .card > div[style*="border-left"] { padding: 12px !important; font-size: 0.95em; }
      .meta { font-size: 0.8em; }
      .card > div:last-child a { display: block; text-align: center; padding: 12px 20px !important; }
    }
  </style>
</Base>
