---
// Placeholder home page. Replaced in Phase 3.
import { env } from 'cloudflare:workers';
const haveDbUrl = Boolean(env?.DATABASE_URL);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>VALUES.md research — scaffold</title>
    <meta name="robots" content="noindex" />
    <style>
      body { font-family: ui-sans-serif, system-ui, sans-serif; max-width: 640px; margin: 4rem auto; padding: 0 1rem; line-height: 1.6; color: #1a1a1a; }
      code { background: #f4f4f0; padding: 0.1em 0.4em; border-radius: 3px; }
      h1 { font-size: 1.4rem; }
      .ok { color: #2a7a2a; }
      .warn { color: #a06a00; }
    </style>
  </head>
  <body>
    <h1>research.values.md — Cloudflare Worker scaffold</h1>
    <p>Phase 0 placeholder. Real routes land in Phases 2–6.</p>
    <ul>
      <li>Adapter: <code>@astrojs/cloudflare</code></li>
      <li>DB binding: {haveDbUrl ? <span class="ok">DATABASE_URL present</span> : <span class="warn">DATABASE_URL not set</span>}</li>
      <li>Try <a href="/api/_dbping">/api/_dbping</a></li>
    </ul>
  </body>
</html>
