{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "values-md-research",
	// Move38 account — same as the values.md Next.js worker.
	"account_id": "a7b1e373a9581b6f04e2a48d3abc9aa3",
	// `main` is written into dist/wrangler.json by the @astrojs/cloudflare adapter
	// at build time. Don't set it here or the Cloudflare vite plugin will fail
	// pre-build because the file doesn't exist yet.
	"compatibility_date": "2026-05-20",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "values-md-research-db",
			"database_id": "ec0a8bfb-93d9-4b39-905c-304fa1ec14cc"
		}
	],
	"limits": {
		"cpu_ms": 300000
	},
	// Custom domain. First deploy with this block creates the DNS record + cert.
	"routes": [
		{
			"pattern": "research.values.md",
			"custom_domain": true
		}
	]
	// Secrets (set via `wrangler secret put`):
	//   OPENROUTER_API_KEY
	//   INTERNAL_API_KEY
	//   CF_PURGE_TOKEN (optional, for cache invalidation on writes)
	// (DATABASE_URL retired 2026-08: data migrated from Neon to the D1 binding above)
}